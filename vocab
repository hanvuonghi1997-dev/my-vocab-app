function renderTestMatch(area) {

    const pool =
        testSession.queue
            .map(id =>
                words.find(word =>
                    word.id === id
                )
            )
            .filter(Boolean);

    const unique =
        shuffle(
            pool.filter(word =>
                !testSession.completed.has(word.id)
            )
        ).slice(0, 3);

    if (unique.length < 2) {

        testSession.current =
            getTestNextWord();

        renderLearn();

        return;
    }

    matchState = {
        words: unique,
        selected: null,
        matched: 0
    };

    const cards =
        shuffle([
            ...unique.map(word => ({
                id: word.id,
                type: "word",
                value: word.word
            })),
            ...unique.map(word => ({
                id: word.id,
                type: "meaning",
                value: word.meaning
            }))
        ]);

    area.innerHTML = `

        <div class="question" style="font-size:25px;">
            Nối các cặp từ
        </div>

        <div class="match-grid">

            ${cards.map((card, index) => `

                <button
                    class="match-card"
                    data-test-match="${index}"
                >
                    ${escapeHTML(card.value)}
                </button>

            `).join("")}

        </div>

        <div
            class="feedback"
            id="testMatchFeedback"
        ></div>
    `;

    matchState.cards = cards;

    document.querySelectorAll(
        "[data-test-match]"
    ).forEach(button => {

        button.addEventListener(
            "click",
            function() {

                const index =
                    Number(
                        this.dataset.testMatch
                    );

                const card =
                    matchState.cards[index];

                if (
                    this.classList.contains("matched")
                ) {
                    return;
                }

                if (!matchState.selected) {

                    matchState.selected = {
                        button: this,
                        card
                    };

                    this.classList.add("selected");

                    return;
                }

                const first =
                    matchState.selected;

                const correct =
                    first.card.id === card.id &&
                    first.card.type !== card.type;

                if (correct) {

                    first.button.classList.remove(
                        "selected"
                    );

                    first.button.classList.add(
                        "matched"
                    );

                    this.classList.add("matched");

                    matchState.matched++;

                    testComplete(
                        unique.find(
                            word =>
                                word.id === card.id
                        )
                    );

                    if (
                        matchState.matched ===
                        unique.length
                    ) {

                        document.getElementById(
                            "testMatchFeedback"
                        ).textContent =
                            "✓ Hoàn thành!";

                        document.getElementById(
                            "testMatchFeedback"
                        ).className =
                            "feedback correct";

                        setTimeout(
                            nextTestQuestion,
                            700
                        );
                    }

                } else {

                    this.classList.add("selected");

                    setTimeout(() => {

                        this.classList.remove(
                            "selected"
                        );

                        first.button.classList.remove(
                            "selected"
                        );

                    }, 450);
                }

                matchState.selected = null;
            }
        );
    });
}

