            "reviewAgain"
        ).addEventListener(
            "click",
            initializeReview
        );

        return;
    }

    const word =
        reviewWords[reviewIndex];

    area.innerHTML = `

        <div style="color:var(--muted);font-size:13px;">
            Từ ${reviewIndex + 1}
            /
            ${reviewWords.length}
        </div>

        <div class="review-word">
            ${escapeHTML(word.word)}
        </div>

        <div style="color:var(--muted);">
            ${escapeHTML(word.pos)}
        </div>

        <div class="review-answer">

            ${
                reviewAnswerVisible

                    ? escapeHTML(word.meaning)

                    : `
                        <button
                            class="btn btn-secondary"
                            id="showAnswer"
                        >
                            <i class="fa-solid fa-eye"></i>
                            Xem đáp án
                        </button>
                    `
            }

        </div>

        ${
            reviewAnswerVisible

                ? `
                    <div class="review-actions">

                        <button
                            class="btn btn-danger"
                            id="forgotBtn"
                        >
                            <i class="fa-solid fa-xmark"></i>
                            Quên
                        </button>

                        <button
                            class="btn btn-success"
                            id="rememberBtn"
                        >
                            <i class="fa-solid fa-check"></i>
                            Nhớ
                        </button>

                    </div>
                `

                : ""
        }
    `;

    const showAnswer =
        document.getElementById(
            "showAnswer"
        );

    if (showAnswer) {

        showAnswer.addEventListener(
            "click",
            function() {

                reviewAnswerVisible = true;

                renderReview();
            }
        );
    }

    const forgot =
        document.getElementById(
            "forgotBtn"
        );

    if (forgot) {

        forgot.addEventListener(
            "click",
            function() {

                word.mastered = false;

                word.reviewStage = 0;

                word.nextReview =
                    datePlusDays(1);

                saveWords();

                reviewIndex++;

                reviewAnswerVisible = false;

                renderAll();

                renderReview();

                updateStreak();

                showToast(
                    "📖 Chưa nhớ — sẽ ôn lại sau 1 ngày."
                );
            }
        );
    }

    const remember =
        document.getElementById(
            "rememberBtn"
        );

    if (remember) {

        remember.addEventListener(
            "click",
            function() {

                word.mastered = true;

                word.reviewStage =
                    Math.min(
                        (word.reviewStage || 0) + 1,
                        REVIEW_INTERVALS.length
                    );

                const interval =
                    REVIEW_INTERVALS[
                        word.reviewStage - 1
                    ] || 60;

                word.nextReview =
                    datePlusDays(interval);

                saveWords();

                reviewIndex++;

                reviewAnswerVisible = false;

                renderAll();

                renderReview();

                updateStreak();

                showToast(
                    `🌱 Đã nhớ! Ôn lại sau ${interval} ngày.`
                );
            }
        );
    }
}

/* =========================================================
   RENDER ALL
========================================================= */

function renderAll() {

    renderVault();

    renderStats();

    renderGrowth();
}

/* =========================================================
   INIT
========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        loadWords();

        renderAll();

        renderLearn();

        initializeReview();

    }
);
</script>

</body>
</html>
