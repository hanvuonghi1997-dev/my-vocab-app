<script>
"use strict";

/* =========================================================
   CONFIG
========================================================= */

const STORAGE_KEY = "vocabVaultV2Data";
const STREAK_KEY = "vocabVaultV2Streak";

const REVIEW_INTERVALS = [1, 3, 7, 14, 30, 60];

/*
    CEFR dictionary mẫu.
    Có thể mở rộng sau này hoặc thay bằng API.
*/

const CEFR_DICTIONARY = {
    achieve: "A2",
    ability: "A2",
    accept: "A2",
    achieve: "A2",
    beautiful: "A1",
    believe: "A2",
    challenge: "B1",
    communicate: "B1",
    convey: "B2",
    difficult: "A2",
    environment: "B1",
    essential: "B2",
    insight: "B2",
    improve: "A2",
    important: "A1",
    opportunity: "B1",
    overboard: "B2",
    resilient: "C1",
    responsibility: "B2",
    solution: "B1",
    understand: "A1",
    vocabulary: "A2"
};

/* =========================================================
   MOCK DATA
========================================================= */

function makeMockWord(word, pos, meaning, cefr) {

    return {
        id: generateId(),
        word,
        pos,
        meaning,
        cefr: cefr || detectCEFR(word),
        nextReview: datePlusDays(0),
        reviewStage: 0,
        mastered: false,
        createdAt: new Date().toISOString()
    };
}

const MOCK_DATA = [
    makeMockWord(
        "resilient",
        "adjective",
        "kiên cường; có khả năng phục hồi",
        "C1"
    ),
    makeMockWord(
        "insight",
        "noun",
        "sự hiểu biết sâu sắc",
        "B2"
    ),
    makeMockWord(
        "achieve",
        "verb",
        "đạt được",
        "A2"
    ),
    makeMockWord(
        "convey",
        "verb",
        "truyền đạt; chuyển tải",
        "B2"
    ),
    makeMockWord(
        "overboard",
        "adverb",
        "quá mức; thái quá",
        "B2"
    ),
    makeMockWord(
        "environment",
        "noun",
        "môi trường",
        "B1"
    ),
    makeMockWord(
        "opportunity",
        "noun",
        "cơ hội",
        "B1"
    ),
    makeMockWord(
        "improve",
        "verb",
        "cải thiện",
        "A2"
    )
];

/* =========================================================
   STATE
========================================================= */

let words = [];

let currentMode = "test";

let currentPracticeWord = null;

let testSession = null;

let reviewWords = [];
let reviewIndex = 0;
let reviewAnswerVisible = false;

let matchState = null;

/* =========================================================
   HELPERS
========================================================= */

function generateId() {

    if (
        window.crypto &&
        typeof window.crypto.randomUUID === "function"
    ) {
        return window.crypto.randomUUID();
    }

    return Date.now().toString(36) +
        Math.random().toString(36).slice(2);
}

function datePlusDays(days) {

    const date = new Date();

    date.setHours(0, 0, 0, 0);

    date.setDate(date.getDate() + days);

    return formatDate(date);
}

function formatDate(date) {

    const d = new Date(date);

    const year = d.getFullYear();

    const month =
        String(d.getMonth() + 1).padStart(2, "0");

    const day =
        String(d.getDate()).padStart(2, "0");

    return `${year}-${month}-${day}`;
}

function today() {

    return formatDate(new Date());
}

function shuffle(array) {

    const result = [...array];

    for (
        let i = result.length - 1;
        i > 0;
        i--
    ) {

        const j =
            Math.floor(Math.random() * (i + 1));

        [result[i], result[j]] =
            [result[j], result[i]];
    }

    return result;
}

function randomItem(array) {

    if (!array.length) {
        return null;
    }

    return array[
        Math.floor(Math.random() * array.length)
    ];
}

function escapeHTML(value) {

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}

function saveWords() {

    localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(words)
    );
}

function loadWords() {

    try {

        const stored =
            localStorage.getItem(STORAGE_KEY);

        if (stored) {

            const parsed =
                JSON.parse(stored);

            if (Array.isArray(parsed)) {

                words = parsed.map(normalizeWord);

                return;
            }
        }

    } catch (error) {

        console.error(
            "Không thể đọc localStorage:",
            error
        );
    }

    words = MOCK_DATA;

    saveWords();
}

function normalizeWord(word) {

    return {
        id: word.id || generateId(),
        word: word.word || "",
        pos: word.pos || "other",
        meaning: word.meaning || "",
        cefr: word.cefr || detectCEFR(word.word),
        nextReview: word.nextReview || today(),
        reviewStage: Number.isFinite(word.reviewStage)
            ? word.reviewStage
            : 0,
        mastered: Boolean(word.mastered),
        createdAt:
            word.createdAt ||
            new Date().toISOString()
    };
}

function detectCEFR(word) {

    if (!word) {
        return null;
    }

    return CEFR_DICTIONARY[
        word.trim().toLowerCase()
    ] || null;
}

function showToast(message) {

    const toast =
        document.getElementById("toast");

    toast.textContent = message;

    toast.classList.add("show");

    clearTimeout(showToast.timer);

    showToast.timer =
        setTimeout(() => {
            toast.classList.remove("show");
        }, 2200);
}

/* =========================================================
   STREAK
========================================================= */

function getStreak() {

    try {

        return JSON.parse(
            localStorage.getItem(STREAK_KEY)
        ) || {
            count: 0,
            lastActive: null
        };

    } catch {

        return {
            count: 0,
            lastActive: null
        };
    }
}

function saveStreak(streak) {

    localStorage.setItem(
        STREAK_KEY,
        JSON.stringify(streak)
    );
}

function updateStreak() {

    const streak = getStreak();

    const currentDate = today();

    if (!streak.lastActive) {

        streak.count = 1;

    } else if (
        streak.lastActive !== currentDate
    ) {

        const oldDate =
            new Date(streak.lastActive);

        const newDate =
            new Date(currentDate);

        const difference =
            Math.round(
                (newDate - oldDate) / 86400000
            );

        if (difference === 1) {

            streak.count++;

        } else if (difference > 1) {

            streak.count = 1;
        }
    }

    streak.lastActive = currentDate;

    saveStreak(streak);

    renderGrowth();
}

/* =========================================================
   GROWTH
========================================================= */

function getGrowthData() {

    const completed =
        words.filter(word => word.mastered).length;

    if (completed < 5) {

        return {
            name: "🌱 Mầm",
            min: 0,
            max: 5
        };
    }

    if (completed < 15) {

        return {
            name: "🌿 Cây non",
            min: 5,
            max: 15
        };
    }

    if (completed < 35) {

        return {
            name: "🌳 Cây trưởng thành",
            min: 15,
            max: 35
        };
    }

    if (completed < 70) {

        return {
            name: "🌲 Cổ thụ",
            min: 35,
            max: 70
        };
    }

    return {
        name: "🌳✨ Đại cổ thụ",
        min: 70,
        max: 100
    };
}

function renderGrowth() {

    const completed =
        words.filter(word => word.mastered).length;

    const tree =
        getGrowthData();

    const streak =
        getStreak();

    const range =
        tree.max - tree.min;

    const current =
        Math.max(
            0,
            Math.min(
                completed - tree.min,
                range
            )
        );

    const percent =
        range > 0
            ? (current / range) * 100
            : 0;

    document.getElementById("streakCount")
        .textContent =
        `${streak.count} ngày`;

    document.getElementById("treeLevel")
        .textContent =
        tree.name;

    document.getElementById("treeProgressText")
        .textContent =
        `${completed} từ thuộc`;

    document.getElementById("treeProgress")
        .style.width =
        `${percent}%`;
}

/* =========================================================
   STATS
========================================================= */

function getDueWords() {

    const currentDate = today();

    return words.filter(word =>
        word.nextReview <= currentDate
    );
}

function renderStats() {

    const due =
        getDueWords();

    const mastered =
        words.filter(word => word.mastered);

    document.getElementById("vaultBadge")
        .textContent =
        words.length;

    document.getElementById("reviewBadge")
        .textContent =
        due.length;

    document.getElementById("statTotal")
        .textContent =
        words.length;

    document.getElementById("statReview")
        .textContent =
        due.length;

    document.getElementById("statMastered")
        .textContent =
        mastered.length;

    document.getElementById("statStreak")
        .textContent =
        getStreak().count;
}

/* =========================================================
   VAULT
========================================================= */

function renderVault() {

    const tbody =
        document.getElementById("vaultTable");

    const search =
        document.getElementById("searchInput")
            .value
            .trim()
            .toLowerCase();

    const cefr =
        document.getElementById("cefrFilter").value;

    const filtered =
        words
            .filter(word => {

                const matchesSearch =
                    !search ||
                    word.word.toLowerCase()
                        .includes(search) ||
                    word.meaning.toLowerCase()
                        .includes(search) ||
                    word.pos.toLowerCase()
                        .includes(search);

                const matchesCEFR =
                    cefr === "all" ||
                    word.cefr === cefr;

                return matchesSearch &&
                    matchesCEFR;
            })
            .sort((a, b) =>
                a.word.localeCompare(b.word)
            );

    if (!filtered.length) {

        tbody.innerHTML = `
            <tr>
                <td colspan="6">
                    <div class="empty">
                        <i class="fa-solid fa-box-open"></i>
                        Không tìm thấy từ nào.
                    </div>
                </td>
            </tr>
        `;

        return;
    }

    tbody.innerHTML =
        filtered.map(word => {

            const due =
                word.nextReview <= today();

            return `
                <tr>

                    <td>
                        <span class="word">
                            ${escapeHTML(word.word)}
                        </span>
                    </td>

                    <td>
                        ${escapeHTML(word.pos)}
                    </td>

                    <td>
                        ${escapeHTML(word.meaning)}
                    </td>

                    <td>
                        ${
                            word.cefr
                                ? `<span class="cefr">${escapeHTML(word.cefr)}</span>`
                                : `<span style="color:var(--muted)">—</span>`
                        }
                    </td>

                    <td style="color:${due ? "var(--warning)" : "var(--muted)"}">
                        ${
                            due
                                ? "🔔 Hôm nay"
                                : escapeHTML(word.nextReview)
                        }
                    </td>

                    <td>

                        <button
                            class="btn btn-danger btn-small"
                            data-delete="${escapeHTML(word.id)}"
                            title="Xóa"
                        >
                            <i class="fa-solid fa-trash"></i>
                        </button>

                    </td>

                </tr>
            `;
        }).join("");
}

/* =========================================================
   ADD WORD
========================================================= */

function addWord(word, pos, meaning) {

    word = word.trim();
    pos = pos.trim();
    meaning = meaning.trim();

    if (!word || !meaning) {

        showToast(
            "Vui lòng nhập đầy đủ thông tin."
        );

        return false;
    }

    const exists =
        words.some(item =>
            item.word.toLowerCase() ===
            word.toLowerCase()
        );

    if (exists) {

        showToast(
            `"${word}" đã có trong kho.`
        );

        return false;
    }

    words.push({
        id: generateId(),
        word,
        pos: pos || "other",
        meaning,
        cefr: detectCEFR(word),
        nextReview: today(),
        reviewStage: 0,
        mastered: false,
        createdAt: new Date().toISOString()
    });

    saveWords();

    renderAll();

    return true;
}

document.getElementById("manualForm")
    .addEventListener("submit", function(event) {

        event.preventDefault();

        const word =
            document.getElementById("wordInput").value;

        const pos =
            document.getElementById("posInput").value;

        const meaning =
            document.getElementById("meaningInput").value;

        if (addWord(word, pos, meaning)) {

            this.reset();

            updateStreak();

            showToast("🌱 Đã thêm từ mới!");

            document.getElementById("wordInput")
                .focus();
        }
    });

document.getElementById("bulkImportBtn")
    .addEventListener("click", function() {

        const textarea =
            document.getElementById("bulkInput");

        const lines =
            textarea.value.split(/\r?\n/);

        let added = 0;
        let skipped = 0;

        lines.forEach(line => {

            const clean =
                line.trim();

            if (!clean) {
                return;
            }

            const parts =
                clean.split(",");

            if (parts.length < 3) {

                skipped++;

                return;
            }

            const word =
                parts[0].trim();

            const pos =
                parts[1].trim();

            const meaning =
                parts
                    .slice(2)
                    .join(",")
                    .trim();

            if (addWord(word, pos, meaning)) {

                added++;

            } else {

                skipped++;
            }
        });

        textarea.value = "";

        if (added) {

            updateStreak();

            showToast(
                `🌱 Đã import ${added} từ.`
            );

        } else {

            showToast(
                "Không có từ mới được thêm."
            );
        }

        if (skipped) {

            console.info(
                `${skipped} dòng bị bỏ qua.`
            );
        }
    });

/* =========================================================
   DELETE
========================================================= */

document.getElementById("vaultTable")
    .addEventListener("click", function(event) {

        const button =
            event.target.closest("[data-delete]");

        if (!button) {
            return;
        }

        const id =
            button.getAttribute("data-delete");

        const target =
            words.find(word =>
                word.id === id
            );

        if (!target) {
            return;
        }

        if (!confirm(
            `Bạn có chắc muốn xóa "${target.word}" không?`
        )) {
            return;
        }

        words =
            words.filter(word =>
                word.id !== id
            );

        saveWords();

        renderAll();

        showToast("Đã xóa từ.");
    });

/* =========================================================
   SEARCH / FILTER
========================================================= */

document.getElementById("searchInput")
    .addEventListener("input", renderVault);

document.getElementById("cefrFilter")
    .addEventListener("change", renderVault);

/* =========================================================
   EXPORT
========================================================= */

document.getElementById("exportBtn")
    .addEventListener("click", function() {

        const data =
            JSON.stringify(words, null, 2);

        const blob =
            new Blob(
                [data],
                { type: "application/json" }
            );

        const url =
            URL.createObjectURL(blob);

        const link =
            document.createElement("a");

        link.href = url;

        link.download =
            `vocab-vault-${today()}.json`;

        document.body.appendChild(link);

        link.click();

        link.remove();

        URL.revokeObjectURL(url);

        showToast(
            "📦 Đã export dữ liệu JSON."
        );
    });

/* =========================================================
   TABS
========================================================= */

document.querySelectorAll(".tab")
    .forEach(tab => {

        tab.addEventListener("click", function() {

            const target =
                this.dataset.tab;

            document.querySelectorAll(".tab")
                .forEach(item =>
                    item.classList.remove("active")
                );

            document.querySelectorAll(".tab-content")
                .forEach(item =>
                    item.classList.remove("active")
                );

            this.classList.add("active");

            const content =
                document.getElementById(
                    `tab-${target}`
                );

            if (content) {
                content.classList.add("active");
            }

            if (target === "learn") {
                renderLearn();
            }

            if (target === "review") {
                initializeReview();
            }
        });
    });

/* =========================================================
   LEARN MODE BUTTONS
========================================================= */

document.querySelectorAll(".mode-btn")
    .forEach(button => {

        button.addEventListener("click", function() {

            currentMode =
                this.dataset.mode;

            document.querySelectorAll(".mode-btn")
