<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VocabVault V2</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
:root {
    --bg: #1A2421;
    --panel: #24322E;
    --panel-2: #2d3d38;
    --border: rgba(232,239,239,.10);
    --text: #E8EFEF;
    --muted: #9eafab;
    --accent: #fdfd96;
    --success: #7ee2a8;
    --danger: #ff7f7f;
    --warning: #ffd580;
    --shadow: 0 12px 35px rgba(0,0,0,.25);
    --radius: 16px;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: "Inter", sans-serif;
    color: var(--text);
    background:
        radial-gradient(circle at 90% 5%, rgba(253,253,150,.06), transparent 25%),
        var(--bg);
}

button,
input,
textarea,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

button:disabled {
    opacity: .45;
    cursor: not-allowed;
}

.app {
    width: min(1450px, 100%);
    margin: auto;
    padding: 20px;
}

/* HEADER */

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
    margin-bottom: 18px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 13px;
}

.logo {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    color: var(--bg);
    background: var(--accent);
    font-size: 22px;
    box-shadow: 0 8px 25px rgba(253,253,150,.15);
}

.brand h1 {
    margin: 0;
    font-size: 21px;
}

.brand small {
    color: var(--muted);
}

.growth {
    display: flex;
    align-items: center;
    gap: 18px;
    width: min(600px, 100%);
}

.streak {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-weight: 700;
    white-space: nowrap;
}

.growth-info {
    flex: 1;
}

.growth-top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 7px;
    color: var(--muted);
    font-size: 12px;
}

.progress {
    height: 9px;
    overflow: hidden;
    border-radius: 99px;
    background: rgba(255,255,255,.08);
}

.progress-bar {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
    transition: width .4s ease;
}

/* NAV */

.tabs {
    position: sticky;
    top: 10px;
    z-index: 20;
    display: flex;
    gap: 5px;
    padding: 6px;
    margin-bottom: 22px;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: rgba(36,50,46,.92);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow);
}

.tab {
    flex: 1;
    min-width: 125px;
    border: 0;
    padding: 12px 14px;
    border-radius: 11px;
    color: var(--muted);
    background: transparent;
    font-weight: 600;
    transition: .2s;
}

.tab:hover {
    color: var(--text);
    background: rgba(255,255,255,.04);
}

.tab.active {
    color: var(--bg);
    background: var(--accent);
}

.badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 20px;
    padding: 0 6px;
    margin-left: 5px;
    border-radius: 99px;
    color: var(--text);
    background: rgba(0,0,0,.18);
    font-size: 11px;
}

/* CONTENT */

.tab-content {
    display: none;
    animation: fadeIn .25s ease;
}

.tab-content.active {
    display: block;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(5px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.page-title {
    margin-bottom: 20px;
}

.page-title h2 {
    margin: 0 0 5px;
    font-size: 25px;
}

.page-title p {
    margin: 0;
    color: var(--muted);
}

/* CARDS */

.card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow);
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
}

.card-body {
    padding: 20px;
}

/* DASHBOARD */

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 20px;
}

.stat-card {
    padding: 20px;
}

.stat-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    margin-bottom: 15px;
    border-radius: 12px;
    color: var(--accent);
    background: rgba(253,253,150,.1);
}

.stat-number {
    font-size: 27px;
    font-weight: 800;
}

.stat-label {
    margin-top: 4px;
    color: var(--muted);
    font-size: 13px;
}

/* FORM */

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.field {
    margin-bottom: 15px;
}

.field label {
    display: block;
    margin-bottom: 7px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
}

.input,
.select,
.textarea {
    width: 100%;
    padding: 12px 14px;
    outline: none;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    background: #1e2a27;
    transition: .2s;
}

.input:focus,
.select:focus,
.textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(253,253,150,.08);
}

.textarea {
    min-height: 230px;
    resize: vertical;
}

.select option {
    background: var(--panel);
}

.btn {
    border: 0;
    border-radius: 10px;
    padding: 11px 15px;
    font-weight: 700;
    transition: .2s;
}

.btn:hover {
    transform: translateY(-1px);
}

.btn-primary {
    color: var(--bg);
    background: var(--accent);
}

.btn-secondary {
    color: var(--text);
    background: rgba(255,255,255,.07);
}

.btn-danger {
    color: var(--danger);
    background: rgba(255,127,127,.1);
}

.btn-success {
    color: #102219;
    background: var(--success);
}

.btn-small {
    padding: 7px 10px;
    font-size: 12px;
}

/* VAULT */

.toolbar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 15px;
}

.search-box {
    position: relative;
    flex: 1;
    min-width: 250px;
}

.search-box i {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
}

.search-box input {
    padding-left: 40px;
}

.table-wrapper {
    overflow-x: auto;
}

table {
    width: 100%;
    min-width: 650px;
    border-collapse: collapse;
}

th {
    padding: 13px 15px;
    text-align: left;
    color: var(--muted);
    background: rgba(0,0,0,.08);
    font-size: 12px;
    font-weight: 600;
}

td {
    padding: 14px 15px;
    border-top: 1px solid var(--border);
    font-size: 13px;
}

tr:hover td {
    background: rgba(255,255,255,.02);
}

.word {
    color: var(--accent);
    font-weight: 700;
}

.cefr {
    display: inline-flex;
    padding: 5px 9px;
    border-radius: 99px;
    color: var(--accent);
    background: rgba(253,253,150,.08);
    font-size: 11px;
    font-weight: 700;
}

/* LEARN */

.mode-switcher {
    display: flex;
    gap: 7px;
    overflow-x: auto;
    margin-bottom: 18px;
}

.mode-btn {
    white-space: nowrap;
    border: 1px solid var(--border);
    padding: 10px 15px;
    border-radius: 10px;
    color: var(--muted);
    background: var(--panel);
}

.mode-btn.active {
    color: var(--bg);
    border-color: var(--accent);
    background: var(--accent);
}

.practice {
    min-height: 440px;
}

.practice-inner {
    max-width: 720px;
    margin: auto;
    text-align: center;
}

.question-label {
    margin-bottom: 15px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .05em;
}

.question {
    margin-bottom: 25px;
    font-size: 31px;
    font-weight: 800;
}

.feedback {
    min-height: 30px;
    margin: 15px 0;
    font-weight: 700;
}

.feedback.correct {
    color: var(--success);
}

.feedback.wrong {
    color: var(--danger);
}

/* TEST */

.test-intro {
    max-width: 650px;
    margin: 20px auto;
    text-align: center;
}

.test-icon {
    width: 80px;
    height: 80px;
    display: grid;
    place-items: center;
    margin: 10px auto 20px;
    border-radius: 24px;
    color: var(--bg);
    background: var(--accent);
    font-size: 32px;
}

.test-intro h3 {
    margin: 0 0 10px;
    font-size: 28px;
}

.test-intro p {
    color: var(--muted);
}

.test-progress {
    max-width: 600px;
    margin: 25px auto;
}

.test-progress-top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 13px;
}

.test-progress-bar {
    height: 10px;
    overflow: hidden;
    border-radius: 99px;
    background: rgba(255,255,255,.08);
}

.test-progress-fill {
    width: 0;
    height: 100%;
    background: var(--accent);
    transition: width .3s ease;
}

.test-type {
    display: inline-flex;
    padding: 6px 10px;
    margin-bottom: 15px;
    border-radius: 99px;
    color: var(--accent);
    background: rgba(253,253,150,.08);
    font-size: 11px;
    font-weight: 700;
}

/* FLASHCARD */

.flashcard-wrap {
    max-width: 540px;
    margin: 25px auto;
    perspective: 1200px;
}

.flashcard {
    height: 280px;
    position: relative;
    cursor: pointer;
    transform-style: preserve-3d;
    transition: transform .65s cubic-bezier(.4,.2,.2,1);
}

.flashcard.flipped {
    transform: rotateY(180deg);
}

.flash-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    padding: 25px;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: linear-gradient(145deg, #2a3a35, #202e2a);
    box-shadow: var(--shadow);
    backface-visibility: hidden;
}

.flash-face.back {
    transform: rotateY(180deg);
}

.flash-word {
    color: var(--accent);
    font-size: 40px;
    font-weight: 800;
}

.flash-meaning {
    font-size: 25px;
    font-weight: 700;
}

.hint {
    margin-top: 12px;
    color: var(--muted);
    font-size: 13px;
}

/* MCQ */

.options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    max-width: 600px;
    margin: auto;
}

.option {
    padding: 16px;
    text-align: left;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text);
    background: var(--panel);
    transition: .2s;
}

.option:hover {
    border-color: var(--accent);
}

.option.correct {
    border-color: var(--success);
    background: rgba(126,226,168,.15);
}

.option.wrong {
    border-color: var(--danger);
    background: rgba(255,127,127,.15);
}

/* MATCH */

.match-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    max-width: 700px;
    margin: auto;
}

.match-card {
    min-height: 75px;
    padding: 20px;
    display: grid;
    place-items: center;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text);
    background: var(--panel);
    cursor: pointer;
    transition: .2s;
}

.match-card.selected {
    border-color: var(--accent);
    background: rgba(253,253,150,.08);
}

.match-card.matched {
    opacity: .3;
    pointer-events: none;
    border-color: var(--success);
}

/* REVIEW */

.review-layout {
    max-width: 700px;
    margin: auto;
}

.review-card {
    min-height: 330px;
    padding: 35px;
    text-align: center;
}

.review-word {
    margin: 20px 0;
    color: var(--accent);
    font-size: 39px;
    font-weight: 800;
}

.review-answer {
    min-height: 60px;
    font-size: 21px;
    font-weight: 600;
}

.review-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 25px;
}

.review-actions .btn {
    min-width: 150px;
}

/* EMPTY */

.empty {
    padding: 50px 20px;
    text-align: center;
    color: var(--muted);
}

.empty i {
    display: block;
    margin-bottom: 15px;
    color: var(--accent);
    font-size: 40px;
}

/* TOAST */

.toast {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 100;
    padding: 13px 17px;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text);
    background: #31433d;
    box-shadow: var(--shadow);
    opacity: 0;
    transform: translateY(120px);
    transition: .3s;
}

.toast.show {
    opacity: 1;
    transform: translateY(0);
}

/* RESPONSIVE */

@media (max-width: 900px) {

    .dashboard-grid {
        grid-template-columns: 1fr 1fr;
    }

    .header {
        flex-direction: column;
        align-items: stretch;
    }

    .growth {
        width: 100%;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 600px) {

    .app {
        padding: 12px;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .options {
        grid-template-columns: 1fr;
    }

    .question {
        font-size: 25px;
    }

    .flash-word {
        font-size: 32px;
    }

    .review-actions {
        flex-direction: column;
    }

    .review-actions .btn {
        width: 100%;
    }
}
</style>
</head>

<body>

<div class="app">

<header class="header">

    <div class="brand">
        <div class="logo">
            <i class="fa-solid fa-book-open"></i>
        </div>

        <div>
            <h1>VocabVault</h1>
            <small>Your personal vocabulary garden</small>
        </div>
    </div>

    <div class="growth">

        <div class="streak">
            <i class="fa-solid fa-fire"></i>
            <span id="streakCount">0 ngày</span>
        </div>

        <div class="growth-info">

            <div class="growth-top">
                <span id="treeLevel">🌱 Mầm</span>
                <span id="treeProgressText">0 XP</span>
            </div>

            <div class="progress">
                <div class="progress-bar" id="treeProgress"></div>
            </div>

        </div>

    </div>

</header>

<nav class="tabs">

    <button class="tab active" data-tab="vault">
        <i class="fa-solid fa-vault"></i>
        Kho từ
        <span class="badge" id="vaultBadge">0</span>
    </button>

    <button class="tab" data-tab="add">
        <i class="fa-solid fa-plus"></i>
        Thêm từ
    </button>

    <button class="tab" data-tab="learn">
        <i class="fa-solid fa-brain"></i>
        Luyện tập
    </button>

    <button class="tab" data-tab="review">
        <i class="fa-solid fa-rotate"></i>
        Ôn tập
        <span class="badge" id="reviewBadge">0</span>
    </button>

</nav>

<!-- VAULT -->

<section class="tab-content active" id="tab-vault">

    <div class="page-title">
        <h2>📚 Kho từ vựng</h2>
        <p>Quản lý toàn bộ vocabulary của bạn.</p>
    </div>

    <div class="dashboard-grid">

        <div class="card stat-card">
            <div class="stat-icon">
                <i class="fa-solid fa-book"></i>
            </div>
            <div class="stat-number" id="statTotal">0</div>
            <div class="stat-label">Tổng số từ</div>
        </div>

        <div class="card stat-card">
            <div class="stat-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div class="stat-number" id="statReview">0</div>
            <div class="stat-label">Cần ôn hôm nay</div>
        </div>

        <div class="card stat-card">
            <div class="stat-icon">
                <i class="fa-solid fa-check"></i>
            </div>
            <div class="stat-number" id="statMastered">0</div>
            <div class="stat-label">Đã thuộc</div>
        </div>

        <div class="card stat-card">
            <div class="stat-icon">
                <i class="fa-solid fa-fire"></i>
            </div>
            <div class="stat-number" id="statStreak">0</div>
            <div class="stat-label">Ngày streak</div>
        </div>

    </div>

    <div class="card">

        <div class="card-header">

            <strong>Danh sách từ</strong>

            <button class="btn btn-secondary" id="exportBtn">
                <i class="fa-solid fa-download"></i>
                Export JSON
            </button>

        </div>

        <div class="card-body">

            <div class="toolbar">

                <div class="search-box">
                    <i class="fa-solid fa-search"></i>

                    <input
                        class="input"
                        id="searchInput"
                        type="search"
                        placeholder="Tìm từ, nghĩa hoặc loại từ..."
                    >
                </div>

                <select class="select" id="cefrFilter" style="max-width:180px;">
                    <option value="all">Tất cả CEFR</option>
                    <option value="A1">A1</option>
                    <option value="A2">A2</option>
                    <option value="B1">B1</option>
                    <option value="B2">B2</option>
                    <option value="C1">C1</option>
                    <option value="C2">C2</option>
                </select>

            </div>

            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>Từ</th>
                            <th>Loại từ</th>
                            <th>Nghĩa</th>
                            <th>CEFR</th>
                            <th>Ôn tiếp theo</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody id="vaultTable"></tbody>

                </table>

            </div>

        </div>

    </div>

</section>

<!-- ADD -->

<section class="tab-content" id="tab-add">

    <div class="page-title">
        <h2>➕ Thêm từ mới</h2>
        <p>Thêm từng từ hoặc import hàng loạt.</p>
    </div>

    <div class="form-grid">

        <div class="card">

            <div class="card-header">
                <strong>Thêm thủ công</strong>
            </div>

            <div class="card-body">

                <form id="manualForm">

                    <div class="field">

                        <label for="wordInput">
                            Word
                        </label>

                        <input
                            class="input"
                            id="wordInput"
                            required
                            autocomplete="off"
                            placeholder="e.g. resilient"
                        >

                    </div>

                    <div class="field">

                        <label for="posInput">
                            Part of Speech
                        </label>

                        <select class="select" id="posInput">

                            <option value="noun">Noun</option>
                            <option value="verb">Verb</option>
                            <option value="adjective">Adjective</option>
                            <option value="adverb">Adverb</option>
                            <option value="phrase">Phrase</option>
                            <option value="other">Other</option>

                        </select>

                    </div>

                    <div class="field">

                        <label for="meaningInput">
                            Meaning
                        </label>

                        <input
                            class="input"
                            id="meaningInput"
                            required
                            placeholder="e.g. kiên cường"
                        >

                    </div>

                    <button class="btn btn-primary" type="submit">
                        <i class="fa-solid fa-plus"></i>
                        Thêm từ
                    </button>

                </form>

            </div>

        </div>

        <div class="card">

            <div class="card-header">
                <strong>Import hàng loạt</strong>
            </div>

            <div class="card-body">

                <p style="color:var(--muted);font-size:13px;">
                    Cú pháp:
                </p>

                <code style="display:block;margin-bottom:15px;color:var(--accent);">
                    Từ, Loại từ, Nghĩa
                </code>

                <textarea
                    class="textarea"
                    id="bulkInput"
                    placeholder="resilient, adjective, kiên cường
achieve, verb, đạt được
insight, noun, sự hiểu biết sâu sắc"
                ></textarea>

                <button
                    class="btn btn-primary"
                    id="bulkImportBtn"
                    style="margin-top:15px;"
                >
                    <i class="fa-solid fa-file-import"></i>
                    Import tất cả
                </button>

            </div>

        </div>

    </div>

</section>

<!-- LEARN -->

<section class="tab-content" id="tab-learn">

    <div class="page-title">

        <h2>🧠 Luyện tập</h2>

        <p>
            Học từng dạng hoặc bắt đầu Test tổng ôn.
        </p>

    </div>

