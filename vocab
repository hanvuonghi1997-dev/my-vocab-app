                    item.classList.remove("active")
                );

            this.classList.add("active");

            resetTestSession();

            renderLearn();
        });
    });

/* =========================================================
   LEARN MAIN
========================================================= */

function renderLearn() {

    const area =
        document.getElementById("practiceArea");

    if (!words.length) {

        area.innerHTML = `
            <div class="empty">
                <i class="fa-solid fa-book-open"></i>
                Kho từ đang trống.
                Hãy thêm từ trước nhé.
            </div>
        `;

        return;
    }

    if (currentMode === "test") {

        renderTest(area);

        return;
    }

    switch (currentMode) {

        case "flashcard":
            renderFlashcard(area);
            break;

        case "mcq":
            renderMCQ(area);
            break;

        case "spelling":
            renderSpelling(area);
            break;

        case "fill":
            renderFill(area);
            break;

        case "match":
            renderMatch(area);
            break;
    }
}

/* =========================================================
   SESSION DATA
========================================================= */

function getLearningPool() {

    const unmastered =
        words.filter(word =>
            !word.mastered
        );

    return unmastered.length
        ? unmastered
        : words;
}

function resetTestSession() {

    testSession = null;
}

/* =========================================================
   TEST
========================================================= */

function createTestSession() {

    const pool =
        getLearningPool();

    testSession = {
        queue: shuffle(pool).map(word => word.id),
        completed: new Set(),
        wrong: new Map(),
        total: pool.length,
        current: null
    };
}

function getTestNextWord() {

    if (!testSession) {
        return null;
    }

    while (testSession.queue.length) {

        const id =
            testSession.queue.shift();

        if (
            !testSession.completed.has(id)
        ) {

            return words.find(
                word => word.id === id
            );
        }
    }

    return null;
}

function testComplete(word) {

    if (!testSession || !word) {
        return;
    }

    testSession.completed.add(word.id);

    word.mastered = true;

    word.reviewStage =
        Math.max(
            word.reviewStage || 0,
            1
        );

    word.nextReview =
        datePlusDays(1);

    saveWords();

    updateStreak();

    renderStats();

    renderGrowth();
}

function testWrong(word) {

    if (!testSession || !word) {
        return;
    }

    const count =
        testSession.wrong.get(word.id) || 0;

    testSession.wrong.set(
        word.id,
        count + 1
    );

    testSession.queue.push(word.id);
}

function renderTest(area) {

    if (!testSession) {
        createTestSession();
    }

    const remaining =
        testSession.queue.filter(id =>
            !testSession.completed.has(id)
        ).length;

    const completed =
        testSession.total -
        remaining;

    if (
        completed >= testSession.total &&
        testSession.total > 0
    ) {

        renderTestComplete(area);

        return;
    }

    if (!testSession.current) {

        testSession.current =
            getTestNextWord();
    }

    if (!testSession.current) {

        renderTestComplete(area);

        return;
    }

    renderTestQuestion(
        area,
        testSession.current
    );
}

function renderTestQuestion(area, word) {

    const total =
        testSession.total;

    const completed =
        testSession.completed.size;

    const percent =
        total
            ? (completed / total) * 100
            : 0;

    const types = [
        "flashcard",
        "mcq",
        "spelling",
        "fill"
    ];

    const mode =
        types[
            (completed + (word.word.length % 3)) %
            types.length
        ];

    if (
        completed > 0 &&
        completed % 4 === 3
    ) {

        renderTestMatch(area);

        return;
    }

    area.innerHTML = `
        <div class="practice-inner">

            <div class="test-progress">

                <div class="test-progress-top">
                    <span>
                        ${completed} / ${total} complete
                    </span>

                    <span>
                        ${Math.round(percent)}%
                    </span>
                </div>

                <div class="test-progress-bar">
                    <div
                        class="test-progress-fill"
                        style="width:${percent}%"
                    ></div>
                </div>

            </div>

            <div class="test-type">
                TEST · ${mode.toUpperCase()}
            </div>

            <div id="testQuestion"></div>

        </div>
    `;

    const question =
        document.getElementById("testQuestion");

    renderTestMode(
        question,
        mode,
        word
    );
}

function renderTestMode(area, mode, word) {

    if (mode === "flashcard") {

        area.innerHTML = `

            <div class="flashcard-wrap">

                <div class="flashcard" id="testFlashcard">

                    <div class="flash-face">

                        <div class="flash-word">
                            ${escapeHTML(word.word)}
                        </div>

                        <div class="hint">
                            ${escapeHTML(word.pos)}
                        </div>

                        <div class="hint">
                            Bấm để xem nghĩa
                        </div>

                    </div>

                    <div class="flash-face back">

                        <div class="flash-meaning">
                            ${escapeHTML(word.meaning)}
                        </div>

                    </div>

                </div>

            </div>

            <div class="feedback">
                Bạn đã nhớ từ này chưa?
            </div>

            <button class="btn btn-success" id="testKnow">
                <i class="fa-solid fa-check"></i>
                Nhớ
            </button>

            <button class="btn btn-danger" id="testDontKnow">
                <i class="fa-solid fa-xmark"></i>
                Chưa nhớ
            </button>
        `;

        document.getElementById("testFlashcard")
            .addEventListener("click", function() {
                this.classList.toggle("flipped");
            });

        setupTestAnswerButtons(word);

        return;
    }

    if (mode === "mcq") {

        renderTestMCQ(area, word);

        return;
    }

    if (mode === "spelling") {

        renderTestSpelling(area, word);

        return;
    }

    renderTestFill(area, word);
}

